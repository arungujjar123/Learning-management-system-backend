# MongoDB Atlas connection string. Never commit the real value.
MONGO_URL_ATLAS=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=LMS

# Required. At least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=
# How long a login token stays valid (e.g. 1h, 12h, 1d)
JWT_EXPIRES_IN=1d

# Used once, on first start, to create the SuperAdmin if none exists.
# Password must be at least 12 characters.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=
